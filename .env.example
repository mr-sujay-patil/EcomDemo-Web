# Copy to .env for local overrides. .env is gitignored; never commit real values.

# Where the dev server and preview proxy send /api requests: the backend gateway (the only backend port this app uses).
API_TARGET=http://localhost:8080

# The read-only clone of the backend, at the pinned tag (docs/process/development-environment.md). Read only: never write to it.
BACKEND_DIR=../ecomdemo-backend-readonly

# The web container (compose.yaml, Phase 19). Compose reads this file itself.
# The port the shop listens on, on this machine only.
WEB_PORT=8070
# The backend's Docker network: <its compose project>_default. `ecomdemo_default` for the backend team's checkout,
# `ecomdemo-backend-readonly_default` for the read-only clone. List them with `docker network ls`.
BACKEND_NETWORK=ecomdemo_default
# Where the container sends /api: the backend's compose service name and port.
API_UPSTREAM=http://gateway-service:8080
