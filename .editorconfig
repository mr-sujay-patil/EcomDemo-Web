# Editor defaults for every file; Prettier reads these too (its own .prettierrc.json wins where both set a value).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
